rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════
    //  Funciones auxiliares
    // ═══════════════════════════════════════════════
    function estaAutenticado() {
      return request.auth != null;
    }

    function esElPropioUsuario(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    // Campos que un usuario tiene permitido modificar de su propio
    // documento (nunca su email, ni su uid, ni su fecha de creación).
    function soloCambiaCamposPermitidos() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['nombreUsuario', 'fotoPerfil']);
    }

    // ═══════════════════════════════════════════════
    //  USUARIOS  → /usuarios/{uid}
    //  Aquí solo se guarda el perfil público dentro del
    //  sitio (nombre visible, foto). NUNCA se guarda ni
    //  se gestiona ninguna contraseña: el acceso siempre
    //  se hace mediante Google Sign-In.
    // ═══════════════════════════════════════════════
    match /usuarios/{uid} {
      // Cualquier persona (incluso sin sesión) puede leer el nombre
      // y la foto pública de un usuario, por ejemplo para mostrarlos
      // junto a sus comentarios.
      allow read: if true;

      // Solo el propio usuario, ya autenticado con Google, puede crear
      // su documento de perfil la primera vez que inicia sesión.
      allow create: if esElPropioUsuario(uid)
                    && request.resource.data.nombreUsuario is string
                    && request.resource.data.nombreUsuario.size() > 0
                    && request.resource.data.nombreUsuario.size() <= 40
                    && request.resource.data.email == request.auth.token.email;

      // Solo el propio usuario puede editar su perfil, y solo
      // los campos permitidos (nombre de usuario y foto).
      allow update: if esElPropioUsuario(uid)
                    && soloCambiaCamposPermitidos()
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['nombreUsuario'])
                        || (request.resource.data.nombreUsuario is string
                            && request.resource.data.nombreUsuario.size() > 0
                            && request.resource.data.nombreUsuario.size() <= 40));

      // Nadie puede borrar perfiles de usuario directamente desde el cliente.
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════
    //  COMENTARIOS PÚBLICOS EN VIDEOS
    //  → /videos/{videoId}/comentarios/{comentarioId}
    //  Cada video (identificado por su ID de YouTube, por
    //  ejemplo) tiene una subcolección de comentarios.
    // ═══════════════════════════════════════════════
    match /videos/{videoId}/comentarios/{comentarioId} {
      // Cualquier persona puede leer los comentarios, con o sin sesión.
      allow read: if true;

      // Solo un usuario autenticado con Google puede publicar un
      // comentario, y solo puede hacerlo a nombre de sí mismo (no
      // puede suplantar el uid o el nombre de otro usuario).
      allow create: if estaAutenticado()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.texto.size() <= 500
                    && request.resource.data.creadoEn == request.time;

      // Un usuario solo puede editar su propio comentario, y solo
      // puede cambiar el texto (no el autor ni la fecha original).
      allow update: if estaAutenticado()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.creadoEn == resource.data.creadoEn
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['texto', 'editadoEn'])
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.texto.size() <= 500
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['editadoEn'])
                        || request.resource.data.editadoEn == request.time);

      // Un usuario puede borrar su propio comentario.
      allow delete: if estaAutenticado() && resource.data.uid == request.auth.uid;
    }

    // ═══════════════════════════════════════════════
    //  PORTAL DE JUEGOS (app «poloaijuegos»)
    //  → /perfiles, /juegos/{juego}/jugadores, /progreso/{uid}/juegos/{juego}
    //  Cada jugador solo escribe en sus propios documentos. Los puntos no pueden bajar ni subir
    //  más de 1000 por envío (debe coincidir con MAX_PUNTOS_POR_ENVIO de compartido/jugador.js).
    //  «progreso» es PRIVADO: solo lo lee y escribe su dueño.
    // ═══════════════════════════════════════════════
    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function textoOk(v, max) {
      return v is string && v.size() <= max;
    }
    // Campos comunes de «perfiles» y de «juegos/.../jugadores»
    function datosOk() {
      let d = request.resource.data;
      return textoOk(d.nombre, 100)
          && textoOk(d.foto, 500)
          && d.actualizado == request.time;
    }
    // Puntaje nuevo (campo = 'total' o 'mejor'): entero, sin bajar y subiendo como máximo MAX_ENVIO
    function puntajeOk(nuevo, previo) {
      return nuevo is int && nuevo >= previo && nuevo - previo <= 1000;
    }

    match /perfiles/{uid} {
      allow read: if true;
      allow create: if esDueno(uid)
        && request.resource.data.keys().hasOnly(['nombre', 'foto', 'actualizado', 'total'])
        && datosOk()
        && puntajeOk(request.resource.data.total, 0);
      allow update: if esDueno(uid)
        && request.resource.data.keys().hasOnly(['nombre', 'foto', 'actualizado', 'total'])
        && datosOk()
        && puntajeOk(request.resource.data.total, resource.data.total);
      // sin «delete»: nadie puede borrar perfiles desde el navegador
    }

    // Avance de cada juego (compartido/progreso.js). Un documento por juego y por jugador, solo del dueño.
    // «datos» es el JSON del progreso como texto (máx. 300 000 caracteres; el límite de Firestore es ~1 MB por documento).
    match /progreso/{uid}/juegos/{juego} {
      allow read, delete: if esDueno(uid);
      allow create, update: if esDueno(uid)
        && juego.size() <= 40 && juego.matches('^[a-z0-9-]+$')
        && request.resource.data.keys().hasOnly(['datos', 'actualizado'])
        && request.resource.data.datos is string
        && request.resource.data.datos.size() <= 300000
        && request.resource.data.actualizado == request.time;
    }

    match /juegos/{juego}/jugadores/{uid} {
      allow read: if true;
      allow create: if esDueno(uid) && juego.size() <= 40
        && request.resource.data.keys().hasOnly(['nombre', 'foto', 'actualizado', 'mejor'])
        && datosOk()
        && puntajeOk(request.resource.data.mejor, 0);
      allow update: if esDueno(uid) && juego.size() <= 40
        && request.resource.data.keys().hasOnly(['nombre', 'foto', 'actualizado', 'mejor'])
        && datosOk()
        && puntajeOk(request.resource.data.mejor, resource.data.mejor);
    }

    // ═══════════════════════════════════════════════
    //  Por defecto, todo lo demás está bloqueado.
    //  Cualquier colección nueva debe agregarse explícitamente arriba.
    // ═══════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
